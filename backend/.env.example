# RAG backend (server-only). Реальные ключи не коммитить.
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.1
EMBED_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INDEX_PERSIST_DIR=backend/storage
# Векторное хранилище: file (дефолт) | qdrant
VECTOR_STORE=file
# Пусто = локальный файл без сервера. Иначе URL self-host/docker/Cloud:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_PATH=backend/qdrant_data
QDRANT_COLLECTION=informatics-8-numsys
# Cloud LLM — только синтетика, не пилот с ПДн. Ключ создать на openrouter.ai/keys,
# хранить только в env/.env (не коммитить). Засвеченный ключ — отозвать и перевыпустить!
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
# Только для облачных/синтетических экспериментов, не для пилота с ПДн:
# OPENAI_API_KEY=
