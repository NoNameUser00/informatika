---
import SpaceBackground from '../components/SpaceBackground';
import BoardFloat from '../components/BoardFloat';
import AuthPanel from '../components/AuthPanel';
import ClassJoin from '../components/ClassJoin';
import '../components/space-background.css';
import '../components/board-float.css';
// ЕДИНЫЙ стиль сайта: тёмный космос + матовое стекло (как главная).
// Контентные карточки — светлое стекло с тёмным текстом, хром — светлый на тёмном.
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Школьная информатика: теория, тренажеры, проверочные.' } = Astro.props;
const B = import.meta.env.BASE_URL;
// Шапка показывает текущий класс: берём из URL (…/7/…, …/11/…), иначе — 8 по умолчанию.
const _segs = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const _baseLen = B.replace(/\/$/, '').split('/').filter(Boolean).length;
const _g = _segs[_baseLen] ?? '';
const navGrade = ['7', '8', '9', '10', '11'].includes(_g) ? _g : '8';
// Раздел учителя — вне классов: grade-ссылки («8 класс») там врут, показываем нейтральные.
const isTeacher = _segs[_baseLen] === 'teacher';
const NAV_TRAINER: Record<string, string> = { '7': 'trainer', '8': 'trainer', '9': 'sheets', '10': 'base', '11': 'data' };
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        --subject: #2563eb; /* информатика — синий, закреплен за предметом везде */
        --bg: #020617;
        --ink: #0f172a; /* текст на светлых стёклах */
        --chrome: #f8fafc; /* текст хрома на тёмном */
        --muted-dark: #b9c4d8; /* приглушённый на тёмном */
        --muted-card: #1e293b; /* приглушённый на стекле */
        --ok-card: #15803d;
        --bad-card: #b91c1c;
        --link-card: #1e3a8a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Nunito, Inter, Roboto, system-ui, sans-serif;
        background: var(--bg);
        color: var(--chrome);
        line-height: 1.6;
      }
      a { color: #93c5fd; }
      .layout-veil {
        position: fixed; inset: 0; z-index: 1; pointer-events: none;
        background: radial-gradient(120% 60% at 50% 0%, rgba(2,6,23,0) 40%, rgba(2,6,23,.55) 100%);
      }
      header.top {
        position: relative; z-index: 2;
        background: rgba(15, 23, 42, 0.55);
        -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
        padding: 12px 20px;
      }
      header.top a { color: #fff; text-decoration: none; font-weight: 800; }
      header.top nav a { margin-right: 16px; color: #c7d2fe; }
      .auth-panel { float: right; font-size: 0.85rem; }
      /* Раскрывашка входа в шапке: одна кнопка вместо россыпи форм. */
      .auth-drop { position: relative; margin-left: auto; }
      .auth-drop > summary { list-style: none; cursor: pointer; }
      .auth-drop > summary::-webkit-details-marker { display: none; }
      .auth-drop-body {
        position: absolute; right: 0; top: calc(100% + 8px); z-index: 50;
        min-width: 280px; max-width: min(92vw, 360px);
        background: rgba(15, 23, 42, 0.97);
        border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 14px;
        padding: 14px 16px;
        box-shadow: 0 12px 40px rgba(2, 6, 23, 0.6);
      }
      .auth-drop-body .auth-panel { float: none; display: block; }
      .auth-drop-body .auth-panel + .auth-panel { margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,.15); }
      .auth-drop-body input[type='text'], .auth-drop-body input[type='password'] {
        width: 100%; margin: 6px 0 0; box-sizing: border-box;
        padding: 10px; font-size: .95rem; border-radius: 10px;
        border: 2px solid rgba(255, 255, 255, 0.35);
        background: rgba(2, 6, 23, 0.6); color: #fff; min-height: 44px;
      }
      .auth-drop-body .auth-btn { margin: 8px 8px 0 0; }
      .auth-btn {
        background: rgba(255,255,255,.14); color: #fff;
        border: 1px solid rgba(255,255,255,.35); border-radius: 999px;
        padding: 6px 14px; min-height: 36px; font-weight: 700; cursor: pointer;
      }
      .auth-btn:disabled { opacity: .5; }
      .auth-error { color: #fca5a5; }
      main { position: relative; z-index: 2; max-width: 880px; margin: 0 auto; padding: 24px 16px 64px; }
      fieldset { min-width: 0; }
      input[type='text'], select, textarea { max-width: 100%; }
      .card { overflow-wrap: break-word; }
      header.top nav { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0; }
      main h1, main h2, main h3 { color: #fff; text-shadow: 0 2px 12px rgba(2,6,23,.8); }
      .card {
        background: rgba(203, 213, 225, 0.82);
        color: var(--ink);
        border: 1px solid rgba(255, 255, 255, 0.55);
        border-radius: 16px;
        padding: 20px;
        margin: 16px 0;
        -webkit-backdrop-filter: blur(14px) saturate(1.5); backdrop-filter: blur(14px) saturate(1.5);
        box-shadow: 0 4px 20px rgba(2, 6, 23, 0.3);
      }
      .card h1, .card h2, .card h3 { color: var(--ink); text-shadow: none; }
      .card a { color: var(--link-card); }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
      .btn {
        display: inline-block;
        background: rgba(251, 191, 36, 0.85);
        color: #451a03;
        border: 1px solid rgba(255, 255, 255, 0.55);
        border-radius: 12px;
        padding: 12px 20px;
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
        min-height: 48px;
        -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
      }
      .btn:disabled { opacity: 0.5; cursor: default; }
      .btn.secondary { background: rgba(30, 41, 59, 0.78); color: #f8fafc; border-color: rgba(255,255,255,.35); font-weight: 700; }
      a.btn, a.btn.secondary { text-decoration: none; }
      label { display: block; margin: 12px 0 4px; font-weight: 700; }
      input[type='text'], select {
        width: 100%;
        padding: 12px;
        font-size: 1rem;
        border-radius: 12px;
        border: 2px solid rgba(255, 255, 255, 0.35);
        background: rgba(15, 23, 42, 0.6);
        color: #fff;
        min-height: 48px;
        -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
      }
      input[type='text']:focus, select:focus { border-color: #fbbf24; outline: none; }
      input[type='text']::placeholder { color: #94a3b8; }
      fieldset { border: 2px solid rgba(255, 255, 255, 0.25); border-radius: 12px; margin: 16px 0; padding: 16px; }
      fieldset.card { border: 1px solid rgba(255, 255, 255, 0.55); }
      fieldset.card > legend { color: var(--ink); float: left; width: 100%; margin: 0 0 8px; padding: 0; }
      legend { font-weight: 800; padding: 0 8px; }
      .radio-row { display: flex; align-items: center; gap: 10px; padding: 10px; min-height: 48px; }
      .radio-row input { width: 22px; height: 22px; accent-color: #fbbf24; }
      .ok { color: var(--ok-card); font-weight: 700; }
      .bad { color: var(--bad-card); font-weight: 700; }
      .muted { color: var(--muted-dark); }
      .card .muted { color: var(--muted-card); }
      .form-error { color: #fca5a5; font-weight: 700; }
      .q { scroll-margin-top: 12px; }
      @media (max-width: 560px) {
        main { padding: 16px 12px 48px; }
        .btn { width: 100%; }
      }
    </style>
  </head>
  <body>
    <SpaceBackground client:load />
    <div class="layout-veil" aria-hidden="true"></div>
    <header class="top">
      <nav>
        <a href={B}>Информатика</a>
        {isTeacher ? (
          <>
            <a href={`${B}trainers/`}>Тренажёры</a>
            <a href={`${B}teacher/`} aria-current="page">Учитель</a>
          </>
        ) : (
          <>
            <a href={`${B}${navGrade}/`}>{navGrade} класс</a>
            <a href={`${B}${navGrade}/${NAV_TRAINER[navGrade]}/`}>Тренажер</a>
            <a href={`${B}teacher/`}>Учитель</a>
          </>
        )}
        <details class="auth-drop">
          <summary class="auth-btn">Вход</summary>
          <div class="auth-drop-body">
            <AuthPanel client:load />
            <ClassJoin client:load />
          </div>
        </details>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <BoardFloat client:load />
  </body>
</html>
