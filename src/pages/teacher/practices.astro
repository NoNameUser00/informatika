---
import Layout from '../../layouts/Layout.astro';
import { getPlay } from '../../data/lesson-play/registry';
import { PRACTICES } from '../../data/lesson-play/practices';
import { PRACTICE_GUIDE } from '../../data/practice-guide';
const B = import.meta.env.BASE_URL;

function gradeOf(id: string): string {
  const m = /^(7|9|10|11)/.exec(id);
  return m ? m[1] : '8';
}

const GRADES = ['7', '8', '9', '10', '11'];
const byGrade = GRADES.map((g) => ({
  grade: g,
  items: Object.keys(PRACTICES)
    .filter((id) => gradeOf(id) === g)
    .map((id) => ({ id, lesson: getPlay(id), guide: PRACTICE_GUIDE[id] })),
})).filter((g) => g.items.length > 0);
---
<Layout title="Методичка: практические работы — учителю">
  <p class="muted"><a href={`${B}teacher/`}>Журнал</a> · Методичка: практические работы</p>
  <h1>Практические работы — что проверять</h1>
  <p class="muted">
    По каждой работе: что смотрит учитель, условие зачёта и типичные ошибки.
    Практика в уроке — перед заданиями, дальше ученика не пускает галочка «Выполнил на компьютере».
    Стенд: ноутбуки МосТех, МосТех.ОС, LibreOffice, КуМир, Python 3.
  </p>
  {byGrade.map((g) => (
    <div class="card">
      <h2>{g.grade} класс</h2>
      {g.items.map(({ id, lesson, guide }) => (
        <article>
          <h3>Урок {lesson.no}: {lesson.title}</h3>
          <p class="muted">{PRACTICES[id].title}</p>
          <p><strong>Смотреть:</strong></p>
          <ul>
            {guide.check.map((c) => <li>{c}</li>)}
          </ul>
          <p><strong>Зачёт:</strong> {guide.pass.join(' ')}</p>
          <p><strong>Типичные ошибки:</strong> {guide.mistakes.join(' ')}</p>
        </article>
      ))}
    </div>
  ))}
</Layout>
