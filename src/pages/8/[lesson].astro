---
import Layout from '../../layouts/Layout.astro';
import RecordVisit from '../../components/RecordVisit';
import { LESSONS_8, ktpLesson, KTP_TOTAL } from '../../data/lessons';
import { hasPlay } from '../../data/lesson-play/registry';
import { mdToHtml, parseFrontmatter } from '../../lib/md';

export function getStaticPaths() {
  return LESSONS_8.map((l) => ({ params: { lesson: l.id } }));
}

const { lesson } = Astro.params;
const meta = LESSONS_8.find((l) => l.id === lesson)!;
const idx = LESSONS_8.indexOf(meta);
const mods = import.meta.glob('../../content/lessons/8/*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const raw = mods[`../../content/lessons/8/${meta.file}`];
const { meta: fm, body } = parseFrontmatter(raw);
const html = mdToHtml(body);
const prev = LESSONS_8[idx - 1];
const next = LESSONS_8[idx + 1];
const B = import.meta.env.BASE_URL;
// Номер урока по КТП: если проставлен — показываем «Урок N. <тема КТП>» и «Урок N из 36».
const ktp = ktpLesson('8', meta.ktp);
const noLabel = ktp ? `Урок ${ktp.n} из ${KTP_TOTAL}` : `Урок ${idx + 1} из ${LESSONS_8.length}`;
const crumb = ktp ? `Урок ${ktp.n}. ${ktp.topic}` : (fm.title ?? meta.title);
---
<Layout title={`${fm.title ?? meta.title} — 8 класс`}>
  <h1>{crumb}</h1>
  <p class="muted">
    <a href={`${B}8/`}>8 класс</a> · {noLabel}
    {ktp && ktp.section && <span> · {ktp.section}</span>}
  </p>
  <RecordVisit
    client:load
    grade="8"
    lesson={meta.id}
    title={`${fm.title ?? meta.title}`}
    href={`${B}8/${meta.id}/`}
  />
  <article class="card" set:html={html} />
  <div class="card">
    <a class="btn" href={`${B}8/trainer/`}>Решить тренажер →</a>
    {hasPlay(meta.id) && <span> <a class="btn secondary" href={`${B}8/play/${meta.id}/`}>Пройти урок целиком (45 мин) →</a></span>}
    {meta.id === 'ss-30-control' && <span> <a class="btn" href={`${B}8/control-ss/`}>Перейти к контрольной →</a></span>}
  </div>
  <p>
    {prev && <a href={`${B}8/${prev.id}/`}>← {prev.title}</a>}
    {prev && next && <span> · </span>}
    {next && <a href={`${B}8/${next.id}/`}>{next.title} →</a>}
  </p>
</Layout>
