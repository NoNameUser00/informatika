---
import Layout from '../../layouts/Layout.astro';
import { LESSONS_8 } from '../../data/lessons';
const B = import.meta.env.BASE_URL;
---
<Layout title="8 класс — Системы счисления">
  <h1>8 класс · Системы счисления</h1>
  <p class="muted">6 уроков по КТП. Задачи — каждый урок, практика — урок 3, проверочная — урок 5.</p>
  <div class="card">
    <a class="btn" href={`${B}8/trainer/`}>Тренажер (как Яндекс.Формы)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/trainer/?mode=proverka`}>Проверочная</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/practice/`}>Практика (урок 3)</a>
  </div>
  {LESSONS_8.map((l, i) => (
    <div class="card">
      <h3>Урок {i + 1}. {l.title}</h3>
      <p><a href={`${B}8/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
</Layout>
