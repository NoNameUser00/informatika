---
import Layout from '../../layouts/Layout.astro';
import { LESSONS_8 } from '../../data/lessons';
const B = import.meta.env.BASE_URL;
---
<Layout title="8 класс — Системы счисления">
  <h1>8 класс · Системы счисления</h1>
  <p class="muted">Учебный год открывает урок 0. Задачи — каждый урок, практика — урок 3, проверочная — урок 5.</p>
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}8/tb/`}>Открыть презентацию →</a></p>
  </div>
  <div class="card">
    <a class="btn" href={`${B}8/trainer/`}>Тренажер СС (как Яндекс.Формы)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/trainer/?mode=proverka`}>Проверочная СС</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/practice/`}>Практика (урок 3)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/code/`}>Код: Python в браузере</a>
  </div>
  {LESSONS_8.filter((l) => l.id.startsWith('numsys')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 1}. {l.title}</h3>
      <p><a href={`${B}8/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Логика</h2>
  <div class="card">
    <a class="btn" href={`${B}8/logic/`}>Тренажер по логике</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/logic/?mode=proverka`}>Проверочная по логике</a>
  </div>
  {LESSONS_8.filter((l) => l.id.startsWith('logic')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 7}. {l.title}</h3>
      <p><a href={`${B}8/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Алгоритмы</h2>
  <div class="card">
    <a class="btn" href={`${B}8/algo/`}>Тренажер по алгоритмам</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/algo/?mode=proverka`}>Проверочная по алгоритмам</a>
  </div>
  {LESSONS_8.filter((l) => l.id.startsWith('alg')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 11}. {l.title}</h3>
      <p><a href={`${B}8/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
</Layout>
