---
import Layout from '../../layouts/Layout.astro';
import StudyProgress from '../../components/StudyProgress';
import { LESSONS_8 } from '../../data/lessons';
const B = import.meta.env.BASE_URL;
---
<Layout title="8 класс — Системы счисления">
  <h1>8 класс · Системы счисления</h1>
  <p class="muted">Учебный год открывает урок 0. Задачи — каждый урок, практика — урок 3, проверочная — урок 5.</p>
  <StudyProgress client:load grade="8" />
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}8/tb/`}>Открыть презентацию →</a></p>
  </div>
  <div class="card">
    <a class="btn" href={`${B}8/trainer/`}>Тренажер СС (как Яндекс.Формы)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/proverka-ss/`}>Проверочная СС (5 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/control-ss/`}>Контрольная СС (8 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/practice/`}>Практика (урок 3)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/code/`}>Код: Python в браузере</a>
  </div>
  {LESSONS_8.filter((l) => l.ktp && l.ktp <= 6).map((l) => (
    <div class="card">
      <h3>Урок {l.ktp}. {l.title}</h3>
      <p><a href={`${B}8/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Логика</h2>
  <div class="card">
    <a class="btn" href={`${B}8/logic/`}>Тренажер по логике</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/proverka-logic/`}>Проверочная (6 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/control-logic/`}>Контрольная (10 заданий)</a>
  </div>
  {LESSONS_8.filter((l) => l.ktp && l.ktp >= 7 && l.ktp <= 12).map((l) => (
    <div class="card">
      <h3>Урок {l.ktp}. {l.title}</h3>
      <p><a href={`${B}8/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Алгоритмы</h2>
  <div class="card">
    <a class="btn" href={`${B}8/algo/`}>Тренажер по алгоритмам</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/proverka-algo/`}>Проверочная (6 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}8/control-algo/`}>Контрольная (10 заданий)</a>
  </div>
  {LESSONS_8.filter((l) => l.ktp && l.ktp >= 13 && l.ktp <= 25).map((l) => (
    <div class="card">
      <h3>Урок {l.ktp}. {l.title}</h3>
      <p><a href={`${B}8/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Python (вместо Паскаля — только Python и КуМир)</h2>
  <div class="card">
    <a class="btn" href={`${B}8/code/`}>Тренажер: код в браузере</a>
  </div>
  {LESSONS_8.filter((l) => l.ktp && l.ktp >= 15).map((l) => (
    <div class="card">
      <h3>Урок {l.ktp}. {l.title}</h3>
      <p><a href={`${B}8/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
</Layout>
