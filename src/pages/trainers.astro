---
import Layout from '../layouts/Layout.astro';
const B = import.meta.env.BASE_URL;

interface T {
  href: string;
  title: string;
  desc: string;
}
const GROUPS: { grade: string; items: T[] }[] = [
  { grade: '7 класс', items: [
    { href: '7/trainer/', title: 'Информация', desc: 'Свойства информации, двоичное кодирование, вес символа и объём текста' },
  ] },
  { grade: '8 класс', items: [
    { href: '8/trainer/', title: 'Системы счисления', desc: 'Переводы 10↔2↔8↔16, триады и тетрады, двоичная арифметика' },
    { href: '8/logic/', title: 'Логика', desc: 'Высказывания, операции И/ИЛИ/НЕ, таблицы истинности' },
    { href: '8/algo/', title: 'Алгоритмы', desc: 'Исполнители, ветвления, циклы, Вычислитель и Черепаха' },
    { href: '8/code/', title: 'Код Python', desc: 'Программа в браузере: ввод-вывод, ветвления, циклы, строки' },
  ] },
  { grade: '9 класс', items: [
    { href: '9/sheets/', title: 'Таблицы', desc: 'Формулы, относительные и абсолютные ссылки, функции, диаграммы' },
    { href: '9/arrays/', title: 'Массивы', desc: 'Списки, накопители, поиск, максимум и сортировка' },
    { href: '9/graphs/', title: 'Графы', desc: 'Вершины и рёбра, матрицы смежности, подсчёт путей' },
    { href: '9/extra/', title: 'Роботы, модели, интернет', desc: 'Управление и датчики, модели, IP-адреса и DNS' },
  ] },
  { grade: '10 класс', items: [
    { href: '10/base/', title: 'Железо и информация', desc: 'Устройство компьютера, измерение информации, условие Фано' },
    { href: '10/ss/', title: 'Системы счисления', desc: 'P-ичные системы, дроби, числа в памяти, кодировки' },
    { href: '10/logic/', title: 'Логика', desc: 'Пять операций, уравнения, ДНФ/КНФ, сумматор и триггер' },
    { href: '10/media/', title: 'Документы', desc: 'LibreOffice Writer, графика, 3D, презентации' },
  ] },
  { grade: '11 класс', items: [
    { href: '11/data/', title: 'Анализ данных', desc: 'Статистика, корреляция, подбор параметра, формализация' },
    { href: '11/db/', title: 'Базы данных', desc: 'Таблицы, ключи, выборка, сортировка и фильтры' },
    { href: '11/algo/', title: 'Алгоритмы', desc: 'Автомат, сортировки, матрицы, строки, отладка' },
    { href: '11/net/', title: 'Сети и безопасность', desc: 'Пакеты, маски, DNS, ГИС и госуслуги, защита, ИИ' },
    { href: '11/graph/', title: 'Графы и игры', desc: 'Деревья, кратчайшие пути, выигрышные стратегии' },
  ] },
];
---
<Layout title="Тренажёры по темам — 7–11 классы">
  <p class="muted"><a href={`${B}`}>Главная</a> · Тренажёры</p>
  <h1>Тренажёры по темам</h1>
  <p class="muted">Выбери класс и тему — дальше тренажёр, проверочная и контрольная.</p>
  {GROUPS.map((g) => (
    <div class="card">
      <h2>{g.grade}</h2>
      {g.items.map((t) => (
        <p><a href={`${B}${t.href}`}>{t.title}</a> — {t.desc}</p>
      ))}
    </div>
  ))}
</Layout>
