---
import Layout from '../../layouts/Layout.astro';
import { LESSONS_7 } from '../../data/lessons';
const B = import.meta.env.BASE_URL;
const grade = '7';
---
<Layout title="7 класс — Информатика">
  <h1>7 класс · Информация и кодирование</h1>
  <p class="muted">Учебный год открывает урок 0. Дальше — блок «Информация»: теория, уроки целиком, тренажер.</p>
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}${grade}/tb/`}>Открыть презентацию →</a></p>
  </div>
  <div class="card">
    <a class="btn" href={`${B}${grade}/trainer/`}>Тренажер «Информация»</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-info/`}>Проверочная (5 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-info/`}>Контрольная (8 заданий)</a>
  </div>
  {LESSONS_7.filter((l) => l.id.startsWith('7inf')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 1}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Компьютер, файлы, тексты, графика, интернет</h2>
  <div class="card">
    <a class="btn secondary" href={`${B}${grade}/proverka-7base/`}>Проверочная (5 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-7base/`}>Контрольная (8 заданий)</a>
  </div>
  {LESSONS_7.filter((l) => ['7pc-01-hardware', '7pc-02-files', '7doc-01-text', '7gfx-01-graphics', '7net-01-internet'].includes(l.id)).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 5}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Мультимедиа и практика</h2>
  <div class="card">
    <a class="btn secondary" href={`${B}${grade}/proverka-7media/`}>Проверочная (5 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-7media/`}>Контрольная (8 заданий)</a>
  </div>
  {LESSONS_7.filter((l) => ['7media-01-slides', '7gfx-02-editors', '7soft-01-practice', '7code-01-sound'].includes(l.id)).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 10}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
</Layout>
