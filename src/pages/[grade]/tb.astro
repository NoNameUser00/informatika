---
import Layout from '../../layouts/Layout.astro';
import Slides from '../../components/Slides';
import { splitSlides, parseFrontmatter } from '../../lib/md';
import quiz from '../../data/tb-quiz.json';
import raw from '../../content/lessons/tb-safety.md?raw';

export function getStaticPaths() {
  return ['7', '8', '9', '10', '11'].map((grade) => ({ params: { grade } }));
}

const { grade } = Astro.params;
const { body } = parseFrontmatter(raw);
const { title, slides } = splitSlides(body);
---
<Layout title={`${title} — ${grade} класс`}>
  <p class="muted"><a href={`${import.meta.env.BASE_URL}${grade}/`}>{grade} класс</a> · Урок 0 · открывает учебный год</p>
  <Slides client:load title={title} slides={slides} quiz={(quiz as any).tasks} />
</Layout>
