---
import Layout from '../../layouts/Layout.astro';
import StudyProgress from '../../components/StudyProgress';
import { LESSONS_10 } from '../../data/lessons';
const B = import.meta.env.BASE_URL;
const grade = '10';
// Разделы КТП 10 класса: уроки сгруппированы по блокам, нумерация — по КТП (1..36).
const SECTIONS = [
  { title: 'Уроки 1–6. Компьютер, программы, файлы и лицензии', range: [1, 6] as const, checks: [
    { name: 'Тренажер: железо и информация', slug: 'base' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-10base' },
    { name: 'Контрольная (5 заданий)', slug: 'control-10base' },
  ] },
  { title: 'Уроки 7–11. Информация и информационные процессы', range: [7, 11] as const, checks: null },
  { title: 'Уроки 12–19. Системы счисления и кодирование информации', range: [12, 19] as const, checks: [
    { name: 'Тренажер: СС и кодировки', slug: 'ss' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-10adv' },
    { name: 'Контрольная (10 заданий)', slug: 'control-10adv' },
  ] },
  { title: 'Уроки 20–28. Алгебра логики и итоги', range: [20, 28] as const, checks: [
    { name: 'Тренажер: логика', slug: 'logic' },
  ] },
  { title: 'Уроки 29–36. Документы, графика и мультимедиа', range: [29, 36] as const, checks: [
    { name: 'Тренажер: документы', slug: 'media' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-10media' },
    { name: 'Контрольная (6 заданий)', slug: 'control-10media' },
  ] },
];
---
<Layout title="10 класс — Информатика">
  <h1>10 класс · Железо, информация, логика</h1>
  <p class="muted">36 уроков по КТП. Учебный год открывает вводный слайд по технике безопасности.</p>
  <StudyProgress client:load grade="10" />
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}${grade}/tb/`}>Открыть презентацию →</a></p>
  </div>
  {SECTIONS.map((sec) => (
    <Fragment>
      <h2>{sec.title}</h2>
      {sec.checks && (
        <div class="card">
          {sec.checks.map((c) => (
            <Fragment>
              <a class="btn secondary" href={`${B}${grade}/${c.slug}/`}>{c.name}</a>
              <span> </span>
            </Fragment>
          ))}
        </div>
      )}
      {LESSONS_10.filter((l) => sec.range[0] <= (l.ktp ?? 0) && (l.ktp ?? 99) <= sec.range[1]).map((l) => (
        <div class="card">
          <h3>Урок {l.ktp}. {l.title}</h3>
          <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
        </div>
      ))}
    </Fragment>
  ))}
</Layout>
