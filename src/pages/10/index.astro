---
import Layout from '../../layouts/Layout.astro';
import StudyProgress from '../../components/StudyProgress';
import { LESSONS_10 } from '../../data/lessons';
const B = import.meta.env.BASE_URL;
const grade = '10';
---
<Layout title="10 класс — Информатика">
  <h1>10 класс · Железо, информация, логика</h1>
  <p class="muted">Учебный год открывает урок 0. Дальше — четыре блока: теория, уроки целиком, тренажеры, проверочные и контрольные.</p>
  <StudyProgress client:load grade="10" />
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}${grade}/tb/`}>Открыть презентацию →</a></p>
  </div>
  <h2>Железо и информация</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/base/`}>Тренажер: железо и информация</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-10base/`}>Проверочная (6 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-10base/`}>Контрольная (5 заданий)</a>
  </div>
  {LESSONS_10.filter((l) => l.id.startsWith('10hw') || l.id.startsWith('10info')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 1}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>СС, кодировки и логика</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/ss/`}>Тренажер: СС и кодировки</a>
    <span> </span>
    <a class="btn" href={`${B}${grade}/logic/`}>Тренажер: логика</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-10adv/`}>Проверочная (6 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-10adv/`}>Контрольная (10 заданий)</a>
  </div>
  {LESSONS_10.filter((l) => l.id.startsWith('10ss') || l.id.startsWith('10logic')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 3}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Документы и мультимедиа</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/media/`}>Тренажер: документы</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-10media/`}>Проверочная (6 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-10media/`}>Контрольная (6 заданий)</a>
  </div>
  {LESSONS_10.filter((l) => l.id.startsWith('10media')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 6}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
</Layout>
