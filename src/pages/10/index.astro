---
import Layout from '../../layouts/Layout.astro';
const B = import.meta.env.BASE_URL;
const grade = '10';
---
<Layout title="10 класс — Информатика">
  <h1>10 класс</h1>
  <p class="muted">Учебный год открывает урок 0. Остальные темы — следующий этап наполнения.</p>
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}${grade}/tb/`}>Открыть презентацию →</a></p>
  </div>
</Layout>
