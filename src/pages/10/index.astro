---
import Layout from '../../layouts/Layout.astro';
const B = import.meta.env.BASE_URL;
const grade = '10';
// Карта тем — по КТП 10 класс. Блоки открываются по мере наполнения (сейчас — урок 0).
const BLOCKS: { title: string; topics: string[] }[] = [
  { title: 'Компьютер: железо и ПО', topics: ['Принципы работы, магистрально-модульная организация', 'Выбор конфигурации, тенденции, суперкомпьютеры', 'Системное и прикладное ПО, лицензии', 'Файлы, хранение данных, администрирование'] },
  { title: 'Информация', topics: ['Двоичное кодирование, условие Фано', 'Вероятностный подход', 'Алфавитный подход', 'Передача: помехи, скорость, обратная связь'] },
  { title: 'Системы счисления (углубление)', topics: ['Алфавит, основание, развёрнутая форма', 'Переводы из P-ичной и обратно (включая дроби)', 'Арифметика', 'Числа в памяти: целые и вещественные'] },
  { title: 'Кодирование', topics: ['Текст и кодировки', 'Графика: дискретизация', 'Звук: дискретизация'] },
  { title: 'Алгебра логики (углубление)', topics: ['Операции, предикаты', 'Выражения и таблицы истинности', 'Законы, эквивалентные преобразования', 'Нормальные формы (ДНФ/КНФ)', 'Логические уравнения', 'Диаграммы Эйлера-Венна', 'Элементы и схемы'] },
  { title: 'Тексты, графика, мультимедиа', topics: ['Текстовый процессор, стили, рецензирование', 'Вёрстка, маттексты', 'Растр и вектор, форматы', '3D, VR/AR', 'Презентации и мультимедиа'] },
];
---
<Layout title="10 класс — Информатика">
  <h1>10 класс · Карта тем</h1>
  <p class="muted">Учебный год открывает урок 0. Темы ниже — план по КТП: блоки открываются по мере наполнения.</p>
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}${grade}/tb/`}>Открыть презентацию →</a></p>
  </div>
  {BLOCKS.map((b) => (
    <div class="card">
      <h3>{b.title} <span class="muted">· скоро</span></h3>
      <ul>
        {b.topics.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  ))}
</Layout>
