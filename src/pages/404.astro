---
import Layout from '../layouts/Layout.astro';
const B = import.meta.env.BASE_URL;
---
<Layout title="404 — страница сбежала">
  <style>
    .ghost { color: inherit; text-decoration: none; cursor: default; }
    .ghost:hover, .ghost:focus-visible { color: #38bdf8; text-shadow: 0 0 14px #38bdf8; cursor: pointer; outline: none; }
    .game-wrap { position: relative; }
    .game-hud { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; margin: 10px 0 4px; }
    .game-btns { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
    .game-touch { display: none; }
    @media (pointer: coarse) { .game-touch { display: flex; } }
  </style>
  <h1><a class="ghost" href={B} aria-label="На главную">404</a> — здесь ничего нет</h1>
  <p class="muted">Тут <a class="ghost" href={B} aria-label="На главную">пусто</a> — только звёзды и погоня. R2-D2 убегает от штурмовиков.</p>
  <div class="card">
    <div class="game-wrap">
      <canvas id="game" width="880" height="260" style="width:100%;height:auto;background:#0b1020;border-radius:12px;" aria-label="Игра: R2-D2 убегает от штурмовиков"></canvas>
    </div>
    <div class="game-hud">
      <span id="score" aria-live="polite">Счёт: 0</span>
      <span id="dodge" aria-live="polite">Обход: 0</span>
      <span id="best">Рекорд: 0</span>
    </div>
    <div class="game-btns">
      <button class="btn" id="start">Старт / заново</button>
      <button class="btn secondary game-touch" id="btnJump">▲ Прыг</button>
      <button class="btn secondary game-touch" id="btnDuck">▼ Низ</button>
    </div>
    <p class="muted" id="msg">Нажми «Старт» или пробел.</p>
    <p class="muted">Пробел / ↑ / тап — прыжок, ↓ — пригнуться, P — пауза. Летающего высоко — пригнись, низкого — перепрыгни. Ходули: прыгай через верх или ныряй между ног. Колобка — перепрыгивай. От бомбардировщика следи за красной тенью.</p>
  </div>
  <script>
    const cv = document.getElementById('game');
    const ctx = cv.getContext('2d');
    const W = cv.width, H = cv.height, GROUND = H - 40;
    const scoreEl = document.getElementById('score');
    const dodgeEl = document.getElementById('dodge');
    const bestEl = document.getElementById('best');
    const msgEl = document.getElementById('msg');
    const startBtn = document.getElementById('start');
    const btnJump = document.getElementById('btnJump');
    const btnDuck = document.getElementById('btnDuck');
    let best = Number(localStorage.getItem('r2-best') || 0);
    bestEl.textContent = 'Рекорд: ' + best;

    let running = false, paused = false, over = true;
    let t = 0, speed = 5, score = 0, dodged = 0, spawnT = 0;
    let enemies = [], bolts = [], bombs = [], craters = [], parts = [];
    let flash = 0, shake = 0;
    const starsFar = [], starsNear = [];
    for (let i = 0; i < 40; i++) starsFar.push({ x: Math.random() * W, y: Math.random() * (GROUND - 80) });
    for (let i = 0; i < 25; i++) starsNear.push({ x: Math.random() * W, y: Math.random() * (GROUND - 40) });
    const r2 = { x: 70, y: GROUND, vy: 0, duck: false, w: 30, h: 52 };

    function reset() {
      t = 0; speed = 5; score = 0; dodged = 0; spawnT = 40;
      enemies = []; bolts = []; bombs = []; craters = []; parts = [];
      flash = 0; shake = 0; paused = false;
      r2.y = GROUND; r2.vy = 0; r2.duck = false; over = false; running = true;
      msgEl.textContent = 'Беги, R2!';
      startBtn.blur();
    }

    function jump() {
      if (over) { reset(); return; }
      if (paused) { paused = false; msgEl.textContent = 'Беги, R2!'; return; }
      if (r2.y >= GROUND) r2.vy = -13.5;
    }

    function togglePause() {
      if (over || !running) return;
      paused = !paused;
      msgEl.textContent = paused ? 'Пауза. P — дальше.' : 'Беги, R2!';
    }

    function boom(x, y, big) {
      const n = big ? 46 : 14;
      for (let i = 0; i < n; i++) {
        const a = Math.random() * Math.PI * 2, v = 1 + Math.random() * (big ? 5 : 2.5);
        parts.push({
          x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v - 1.5,
          life: 30 + Math.random() * (big ? 40 : 20),
          color: ['#fbbf24', '#f97316', '#ef4444', '#94a3b8'][Math.floor(Math.random() * 4)],
        });
      }
    }

    // ---------- R2-D2 ----------
    function drawR2() {
      const h = r2.duck ? 30 : r2.h, y = r2.y - h;
      const squash = r2.duck ? 1.25 : 1, w = r2.w * squash, x = r2.x - (w - r2.w) / 2;
      ctx.fillStyle = '#c0c8d4';
      ctx.fillRect(x, y + 12, w, h - 12); // корпус
      ctx.beginPath(); // купол
      ctx.arc(x + w / 2, y + 12, w / 2, Math.PI, 0);
      ctx.fillStyle = '#d7dee9'; ctx.fill();
      ctx.fillStyle = '#f1f5f9'; // блик купола
      ctx.fillRect(x + w / 2 - 8, y + 1, 4, 6);
      ctx.fillStyle = '#2563eb'; // синие панели
      ctx.fillRect(x + 4, y + 22, 6, h - 26);
      ctx.fillRect(x + w - 10, y + 22, 6, h - 26);
      ctx.fillRect(x + 4, y + h - 8, w - 8, 3);
      const blink = (t % 210) < 12; // глаз моргает
      ctx.fillStyle = blink ? '#475569' : '#dc2626';
      ctx.fillRect(x + w / 2 - 2, y + 7, 4, 4);
      ctx.fillStyle = '#38bdf8'; // фонарик
      ctx.fillRect(x + w / 2 - 1, y + 13, 2, 3);
      ctx.fillStyle = '#64748b'; // ноги-ходули
      const step = running && !over && !paused && r2.y >= GROUND ? Math.floor(t / 6) % 2 : 0;
      ctx.fillRect(x + 2, r2.y - 2, 10, 4 + step * 2);
      ctx.fillRect(x + w - 12, r2.y - 2, 10, 4 + (1 - step) * 2);
      ctx.fillStyle = '#334155'; // колёса
      ctx.fillRect(x + 3, r2.y - 1, 8, 3);
      ctx.fillRect(x + w - 11, r2.y - 1, 8, 3);
    }

    // ---------- противники ----------
    // Летающий штурмовик на джетпаке
    function drawFlyer(e) {
      const bob = Math.sin((t + e.seed * 10) * 0.15) * 3;
      const y = e.y + bob;
      ctx.fillStyle = '#e8ecf3';
      ctx.fillRect(e.x, y, 26, 22);
      ctx.fillStyle = '#cbd5e1'; // ранец
      ctx.fillRect(e.x + 2, y + 4, 5, 14);
      ctx.fillStyle = '#0f172a'; // визор
      ctx.fillRect(e.x + 14, y + 6, 10, 5);
      ctx.fillStyle = '#7dd3fc'; // блик визора
      ctx.fillRect(e.x + 15, y + 7, 3, 2);
      const f = 4 + (t % 3) * 2; // пламя
      ctx.fillStyle = '#f59e0b';
      ctx.fillRect(e.x + 4, y + 22, 6, f);
      ctx.fillRect(e.x + 16, y + 22, 6, f + 2);
      ctx.fillStyle = '#fde68a';
      ctx.fillRect(e.x + 5, y + 22, 4, 3);
      if (Math.random() < 0.3) parts.push({ x: e.x + 7, y: y + 26, vx: -1 - Math.random(), vy: 1 + Math.random(), life: 14, color: '#f59e0b' });
    }

    // Стреляющий штурмовик (на земле)
    function drawShooter(e) {
      ctx.fillStyle = '#e8ecf3';
      ctx.fillRect(e.x, e.y - 44, 22, 30); // торс
      ctx.fillStyle = '#cbd5e1'; // наплечник
      ctx.fillRect(e.x + 2, e.y - 44, 8, 6);
      ctx.fillStyle = '#0f172a'; // визор
      ctx.fillRect(e.x + 8, e.y - 38, 12, 5);
      ctx.fillStyle = '#7dd3fc';
      ctx.fillRect(e.x + 9, e.y - 37, 3, 2);
      ctx.fillStyle = '#94a3b8'; // ноги
      ctx.fillRect(e.x + 2, e.y - 14, 7, 14);
      ctx.fillRect(e.x + 13, e.y - 14, 7, 14);
      ctx.fillStyle = '#334155'; // бластер
      ctx.fillRect(e.x - 12, e.y - 30, 14, 4);
      ctx.fillRect(e.x - 12, e.y - 26, 4, 6);
      if (e.flash > 0) { // вспышка выстрела
        ctx.fillStyle = '#fef08a';
        ctx.fillRect(e.x - 18, e.y - 33, 8, 10);
        ctx.fillStyle = '#f97316';
        ctx.fillRect(e.x - 21, e.y - 30, 4, 4);
      }
    }

    // Ходун-вездеход: прыгай через верх или ныряй между ног
    function drawWalker(e) {
      const legSwing = Math.floor(t / 8 + e.seed * 5) % 2;
      ctx.fillStyle = '#cbd5e1'; // кабина
      ctx.fillRect(e.x + 6, e.y - 88, 44, 32);
      ctx.fillStyle = '#0f172a'; // иллюминатор
      ctx.fillRect(e.x + 32, e.y - 82, 12, 8);
      ctx.fillStyle = '#7dd3fc';
      ctx.fillRect(e.x + 33, e.y - 81, 4, 3);
      const blink = (t % 160) < 60; // красный огонёк
      ctx.fillStyle = blink ? '#dc2626' : '#7f1d1d';
      ctx.fillRect(e.x + 10, e.y - 80, 4, 4);
      ctx.fillStyle = '#94a3b8'; // ноги по краям, середина свободна
      ctx.fillRect(e.x, e.y - 56, 8, 56);
      ctx.fillRect(e.x + 48, e.y - 56, 8, 56);
      ctx.fillStyle = '#64748b'; // ступни вразнобой
      ctx.fillRect(e.x - 4 + legSwing * 8, e.y - 6, 14, 6);
      ctx.fillRect(e.x + 42 + (1 - legSwing) * 8, e.y - 6, 14, 6);
    }

    // Колобок-разведчик: катится быстро и низко
    function drawRoller(e) {
      e.roll = (e.roll || 0) + speed * 0.06;
      ctx.fillStyle = '#0f172a'; // тень
      ctx.beginPath(); ctx.ellipse(e.x, GROUND + 4, 14, 3, 0, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#cbd5e1'; // шар
      ctx.beginPath(); ctx.arc(e.x, e.y, 13, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = '#64748b'; ctx.lineWidth = 2; // спицы
      for (let k = 0; k < 3; k++) {
        const a = e.roll + (k * Math.PI) / 3;
        ctx.beginPath();
        ctx.moveTo(e.x - Math.cos(a) * 11, e.y - Math.sin(a) * 11);
        ctx.lineTo(e.x + Math.cos(a) * 11, e.y + Math.sin(a) * 11);
        ctx.stroke();
      }
      ctx.fillStyle = '#dc2626'; // глаз-сенсор
      ctx.beginPath(); ctx.arc(e.x, e.y, 4, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#fca5a5';
      ctx.beginPath(); ctx.arc(e.x - 1, e.y - 1, 1.5, 0, Math.PI * 2); ctx.fill();
      if (Math.random() < 0.4) parts.push({ x: e.x - 12, y: GROUND - 2, vx: -1, vy: -0.5 - Math.random(), life: 12, color: '#94a3b8' });
    }

    // Бомбардировщик: летит высоко, сбрасывает бомбы
    function drawBomber(e) {
      const bob = Math.sin((t + e.seed * 7) * 0.1) * 2;
      const y = e.y + bob;
      ctx.fillStyle = '#94a3b8'; // крылья
      ctx.fillRect(e.x - 8, y + 4, 56, 5);
      ctx.fillStyle = '#e8ecf3'; // фюзеляж
      ctx.fillRect(e.x + 6, y - 4, 28, 16);
      ctx.fillStyle = '#0f172a'; // кабина
      ctx.fillRect(e.x + 24, y - 1, 10, 6);
      ctx.fillStyle = '#dc2626'; // хвостовой огонь
      ctx.fillRect(e.x + 2, y + 2, 4, 4);
      const blink = (t % 90) < 45; // маячок
      ctx.fillStyle = blink ? '#fbbf24' : '#92400e';
      ctx.fillRect(e.x + 18, y - 7, 4, 3);
    }

    function hitBoxes(e) {
      switch (e.kind) {
        case 'shooter': return [{ x: e.x, y: e.y - 44, w: 22, h: 44 }];
        case 'walker': return [
          { x: e.x + 6, y: e.y - 88, w: 44, h: 32 },
          { x: e.x, y: e.y - 56, w: 8, h: 56 },
          { x: e.x + 48, y: e.y - 56, w: 8, h: 56 },
        ];
        case 'roller': return [{ x: e.x - 12, y: e.y - 12, w: 24, h: 24 }];
        case 'fly': return [{ x: e.x + 2, y: e.y + 2, w: 22, h: 18 }];
        default: return [];
      }
    }

    function update() {
      if (!running || over || paused) return;
      t++;
      speed = 5 + Math.min(7, t / 600);
      score = Math.floor(t / 6);
      // директор спавна: разрыв зависит от скорости, новинки — по времени
      spawnT -= 1;
      if (spawnT <= 0) {
        const r = Math.random();
        if (t > 1100 && r < 0.12) enemies.push({ kind: 'bomber', x: W + 30, y: GROUND - 150, cd: 70, dropped: 0, seed: Math.random(), w: 40 });
        else if (t > 700 && r < 0.27) enemies.push({ kind: 'walker', x: W + 30, y: GROUND, seed: Math.random(), w: 56 });
        else if (t > 350 && r < 0.44) enemies.push({ kind: 'roller', x: W + 20, y: GROUND - 13, seed: Math.random(), w: 26 });
        else if (r < 0.62) enemies.push({ kind: 'fly', x: W + 20, y: GROUND - 70 - Math.random() * 45, seed: Math.random(), w: 26 });
        else if (r < 0.80) enemies.push({ kind: 'fly', x: W + 20, y: GROUND - 34, seed: Math.random(), w: 26 });
        else enemies.push({ kind: 'shooter', x: W + 20, y: GROUND, cd: 50, flash: 0, w: 22 });
        const gap = Math.max(80, (110 + Math.random() * 90) * (6 / speed));
        spawnT = gap;
      }
      // физика R2
      r2.vy += 0.7;
      r2.y += r2.vy;
      if (r2.y > GROUND) { r2.y = GROUND; r2.vy = 0; }
      // пыль из-под ног
      if (r2.y >= GROUND && t % 4 === 0) {
        parts.push({ x: r2.x + 4, y: GROUND + 1, vx: -1.5 - Math.random(), vy: -0.4 - Math.random() * 0.5, life: 18, color: '#475569' });
      }
      // враги
      for (const e of enemies) {
        e.x -= speed * (e.kind === 'roller' ? 1.25 : 1);
        if (e.flash > 0) e.flash--;
        if (e.kind === 'shooter') {
          e.cd -= 1;
          if (e.cd <= 0 && e.x < W - 20 && e.x > 140) {
            bolts.push({ x: e.x - 12, y: e.y - 28, v: 3 + Math.min(5, t / 900) });
            e.cd = 110; e.flash = 6;
          }
        }
        if (e.kind === 'bomber') {
          e.cd -= 1;
          if (e.cd <= 0 && e.dropped < 2 && e.x < W - 60 && e.x > 220) {
            bombs.push({ x: e.x + 20, y: e.y + 12, vy: 0.5 });
            e.dropped++; e.cd = 110;
          }
        }
        if (!e.counted && e.x + e.w < r2.x) { e.counted = true; dodged++; }
      }
      enemies = enemies.filter((e) => e.x > -60);
      for (const b of bolts) b.x -= speed + b.v;
      bolts = bolts.filter((b) => b.x > -20);
      for (const b of bombs) {
        b.vy += 0.45; b.y += b.vy; b.x -= speed;
        if (b.y >= GROUND - 4) {
          craters.push({ x: b.x, life: 50 });
          b.dead = true;
        }
      }
      bombs = bombs.filter((b) => !b.dead && b.x > -20);
      for (const c of craters) c.life--;
      craters = craters.filter((c) => c.life > 0);
      // столкновения
      const rh = r2.duck ? 30 : r2.h;
      const box = (x, y, w, h) =>
        r2.x + 4 < x + w && r2.x + 26 > x && r2.y - rh + 4 < y + h && r2.y > y;
      for (const e of enemies) {
        for (const hb of hitBoxes(e)) {
          if (box(hb.x, hb.y, hb.w, hb.h)) return gameOver();
        }
      }
      for (const b of bolts) if (box(b.x, b.y - 3, 10, 6)) return gameOver();
      for (const b of bombs) if (box(b.x - 6, b.y - 6, 12, 12)) return gameOver();
      scoreEl.textContent = 'Счёт: ' + score;
      dodgeEl.textContent = 'Обход: ' + dodged;
    }

    function gameOver() {
      over = true; running = false;
      boom(r2.x + 15, r2.y - 26, true);
      flash = 26; shake = 10;
      if (score > best) { best = score; localStorage.setItem('r2-best', String(best)); }
      bestEl.textContent = 'Рекорд: ' + best;
      msgEl.textContent = 'Штурмовики поймали R2. Счёт ' + score + ', обход ' + dodged + '. Ещё раз?';
    }

    function drawPlanet() {
      ctx.fillStyle = '#1e293b'; // далёкая планета с кольцом
      ctx.beginPath(); ctx.arc(W - 110, 58, 34, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = '#475569'; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.ellipse(W - 110, 58, 52, 12, -0.35, 0, Math.PI * 2); ctx.stroke();
      ctx.fillStyle = '#334155'; // кратеры
      ctx.beginPath(); ctx.arc(W - 120, 50, 6, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(W - 100, 66, 4, 0, Math.PI * 2); ctx.fill();
    }

    function draw() {
      ctx.save();
      if (shake > 0.5) ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);
      ctx.clearRect(-20, -20, W + 40, H + 40);
      ctx.fillStyle = '#0b1020'; ctx.fillRect(-20, -20, W + 40, H + 40);
      ctx.fillStyle = '#64748b'; // дальние звёзды
      for (const s of starsFar) {
        s.x -= speed * 0.08; if (s.x < 0) { s.x = W; s.y = Math.random() * (GROUND - 80); }
        ctx.fillRect(s.x, s.y, 2, 2);
      }
      drawPlanet();
      ctx.fillStyle = '#e2e8f0'; // ближние звёзды
      for (const s of starsNear) {
        s.x -= speed * 0.25; if (s.x < 0) { s.x = W; s.y = Math.random() * (GROUND - 40); }
        const tw = 1.5 + Math.sin((t + s.x) * 0.1);
        ctx.fillRect(s.x, s.y, tw, tw);
      }
      ctx.fillStyle = '#38bdf8'; // взлётка
      ctx.fillRect(0, GROUND + 2, W, 3);
      ctx.fillStyle = '#0ea5e9';
      for (let gx = -((t * speed) % 44); gx < W; gx += 44) ctx.fillRect(gx, GROUND + 2, 18, 3);
      ctx.fillStyle = '#7c2d12'; // воронки от бомб
      for (const c of craters) {
        ctx.globalAlpha = Math.min(1, c.life / 25);
        ctx.beginPath(); ctx.ellipse(c.x, GROUND + 3, 12, 3, 0, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
      }
      const drawers = { fly: drawFlyer, shooter: drawShooter, walker: drawWalker, roller: drawRoller, bomber: drawBomber };
      for (const e of enemies) (drawers[e.kind] || drawFlyer)(e);
      for (const b of bombs) { // тень места падения + бомба
        ctx.fillStyle = 'rgba(220,38,38,.4)';
        ctx.beginPath(); ctx.ellipse(b.x, GROUND + 4, 10, 3, 0, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#1f2937';
        ctx.fillRect(b.x - 5, b.y - 6, 10, 12);
        ctx.fillStyle = '#dc2626';
        ctx.fillRect(b.x - 2, b.y - 9, 4, 3);
      }
      ctx.fillStyle = '#dc2626'; // болты
      for (const b of bolts) {
        ctx.fillRect(b.x, b.y - 3, 10, 6);
        ctx.fillStyle = '#fca5a5'; ctx.fillRect(b.x, b.y - 1, 10, 2);
        ctx.fillStyle = '#dc2626';
      }
      if (!over) drawR2();
      for (const p of parts) { // частицы живут и после гибели — взрыв видно
        p.x += p.vx; p.y += p.vy; p.vy += 0.15; p.life--;
      }
      for (let i = parts.length - 1; i >= 0; i--) if (parts[i].life <= 0) parts.splice(i, 1);
      if (flash > 0) flash -= 2;
      if (shake > 0.1) shake *= 0.88; else shake = 0;
      for (const p of parts) { // частицы поверх
        ctx.globalAlpha = Math.min(1, p.life / 20);
        ctx.fillStyle = p.color;
        ctx.fillRect(p.x, p.y, 3, 3);
        ctx.globalAlpha = 1;
      }
      if (flash > 0) { ctx.fillStyle = `rgba(255,255,255,${flash / 40})`; ctx.fillRect(0, 0, W, H); }
      if (!running && over && score === 0 && parts.length === 0) {
        drawR2();
        ctx.fillStyle = '#fff'; ctx.font = '20px sans-serif';
        ctx.fillText('R2-D2 ждёт старта', W / 2 - 90, H / 2);
      }
      if (paused) {
        ctx.fillStyle = 'rgba(2,6,23,.55)'; ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = '#fff'; ctx.font = '22px sans-serif';
        ctx.fillText('Пауза — P, чтобы бежать', W / 2 - 130, H / 2);
      }
      ctx.restore();
      requestAnimationFrame(draw);
    }

    document.addEventListener('keydown', (e) => {
      if (e.code === 'Space' || e.code === 'ArrowUp') { e.preventDefault(); jump(); }
      else if (e.code === 'ArrowDown') { e.preventDefault(); if (!over && !paused) r2.duck = true; }
      else if (e.code === 'KeyP') togglePause();
    });
    document.addEventListener('keyup', (e) => { if (e.code === 'ArrowDown') r2.duck = false; });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && running && !over && !paused) togglePause();
    });
    cv.addEventListener('pointerdown', jump);
    startBtn.addEventListener('click', reset);
    btnJump.addEventListener('pointerdown', (e) => { e.preventDefault(); jump(); });
    btnDuck.addEventListener('pointerdown', (e) => { e.preventDefault(); if (!over && !paused) r2.duck = true; });
    const duckOff = () => { r2.duck = false; };
    btnDuck.addEventListener('pointerup', duckOff);
    btnDuck.addEventListener('pointerleave', duckOff);
    setInterval(update, 1000 / 60);
    draw();
  </script>
</Layout>
