---
import Layout from '../../layouts/Layout.astro';
import StudyProgress from '../../components/StudyProgress';
import { LESSONS_11 } from '../../data/lessons';
const B = import.meta.env.BASE_URL;
const grade = '11';
// Разделы КТП 11 класса: уроки сгруппированы по блокам, нумерация — по КТП (1..36).
const SECTIONS = [
  { title: 'Уроки 1–8. Анализ данных и базы данных', range: [1, 8] as const, checks: [
    { name: 'Тренажер: данные', slug: 'data' },
    { name: 'Тренажер: базы данных', slug: 'db' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-11base' },
    { name: 'Контрольная (10 заданий)', slug: 'control-11base' },
  ] },
  { title: 'Уроки 9–19. Алгоритмы углублённо', range: [9, 19] as const, checks: [
    { name: 'Тренажер: алгоритмы', slug: 'algo' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-11algo' },
    { name: 'Контрольная (10 заданий)', slug: 'control-11algo' },
  ] },
  { title: 'Уроки 20–24. Моделирование, графы и игры', range: [20, 24] as const, checks: [
    { name: 'Тренажер: графы и игры', slug: 'graph' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-11graph' },
    { name: 'Контрольная (10 заданий)', slug: 'control-11graph' },
  ] },
  { title: 'Уроки 25–36. Сети, безопасность и искусственный интеллект', range: [25, 36] as const, checks: [
    { name: 'Тренажер: сети', slug: 'net' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-11net' },
    { name: 'Контрольная (10 заданий)', slug: 'control-11net' },
  ] },
];
---
<Layout title="11 класс — Информатика">
  <h1>11 класс · Данные, алгоритмы, сети</h1>
  <p class="muted">36 уроков по КТП. Учебный год открывает вводный слайд по технике безопасности.</p>
  <StudyProgress client:load grade="11" />
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}${grade}/tb/`}>Открыть презентацию →</a></p>
  </div>
  {SECTIONS.map((sec) => (
    <Fragment>
      <h2>{sec.title}</h2>
      <div class="card">
        {sec.checks.map((c) => (
          <Fragment>
            <a class="btn secondary" href={`${B}${grade}/${c.slug}/`}>{c.name}</a>
            <span> </span>
          </Fragment>
        ))}
      </div>
      {LESSONS_11.filter((l) => sec.range[0] <= (l.ktp ?? 0) && (l.ktp ?? 99) <= sec.range[1]).map((l) => (
        <div class="card">
          <h3>Урок {l.ktp}. {l.title}</h3>
          <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
        </div>
      ))}
    </Fragment>
  ))}
</Layout>
