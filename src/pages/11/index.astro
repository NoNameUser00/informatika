---
import Layout from '../../layouts/Layout.astro';
import { LESSONS_11 } from '../../data/lessons';
const B = import.meta.env.BASE_URL;
const grade = '11';
---
<Layout title="11 класс — Информатика">
  <h1>11 класс · Данные, алгоритмы, сети</h1>
  <p class="muted">Учебный год открывает урок 0. Дальше — четыре блока: теория, уроки целиком, тренажеры, проверочные и контрольные.</p>
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}${grade}/tb/`}>Открыть презентацию →</a></p>
  </div>
  <h2>Данные и базы данных</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/data/`}>Тренажер: данные</a>
    <span> </span>
    <a class="btn" href={`${B}${grade}/db/`}>Тренажер: базы данных</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-11base/`}>Проверочная (6 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-11base/`}>Контрольная (10 заданий)</a>
  </div>
  {LESSONS_11.filter((l) => l.id.startsWith('11data') || l.id.startsWith('11db')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 1}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Алгоритмы углублённо</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/algo/`}>Тренажер: алгоритмы</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-11algo/`}>Проверочная (6 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-11algo/`}>Контрольная (10 заданий)</a>
  </div>
  {LESSONS_11.filter((l) => l.id.startsWith('11algo')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 3}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Сети и безопасность</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/net/`}>Тренажер: сети</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-11net/`}>Проверочная (6 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-11net/`}>Контрольная (10 заданий)</a>
  </div>
  {LESSONS_11.filter((l) => l.id.startsWith('11net') || l.id.startsWith('11safe')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 5}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Графы и игры</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/graph/`}>Тренажер: графы и игры</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-11graph/`}>Проверочная (6 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-11graph/`}>Контрольная (10 заданий)</a>
  </div>
  {LESSONS_11.filter((l) => l.id.startsWith('11graph')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 7}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
</Layout>
