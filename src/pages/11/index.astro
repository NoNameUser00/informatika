---
import Layout from '../../layouts/Layout.astro';
const B = import.meta.env.BASE_URL;
const grade = '11';
// Карта тем — по КТП 11 класс. Блоки открываются по мере наполнения (сейчас — урок 0).
const BLOCKS: { title: string; topics: string[] }[] = [
  { title: 'Анализ данных и моделирование', topics: ['Этапы моделирования, анализ данных', 'Статистика в таблицах, диаграммы', 'Корреляция, подбор параметра, оптимизация'] },
  { title: 'Базы данных', topics: ['Реляционные БД: проектирование', 'Заполнение, поиск, сортировка, запросы'] },
  { title: 'Алгоритмы (углубление)', topics: ['Анализ алгоритмов: результат и входные данные', 'Цифры числа, последовательности, перебор', 'Сортировки, матрицы, строки', 'Подпрограммы и рекурсия', 'Сложность: время и память'] },
  { title: 'Графы и игры', topics: ['Графы, деревья', 'Пути в графах', 'Игры с полной информацией, выигрышные стратегии (дерево и таблицы)'] },
  { title: 'Сети', topics: ['Компоненты сетей, протоколы, локальная сеть', 'Интернет: адресация, DNS', 'Веб-страницы (HTML)', 'Сервисы, геосервисы, госуслуги'] },
  { title: 'Безопасность и ИИ', topics: ['Угрозы, право, подпись, архивы и шифрование', 'Вирусы и антивирусы', 'ИИ: перевод, речь, зрение, обучение'] },
];
---
<Layout title="11 класс — Информатика">
  <h1>11 класс · Карта тем</h1>
  <p class="muted">Учебный год открывает урок 0. Темы ниже — план по КТП: блоки открываются по мере наполнения.</p>
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}${grade}/tb/`}>Открыть презентацию →</a></p>
  </div>
  {BLOCKS.map((b) => (
    <div class="card">
      <h3>{b.title} <span class="muted">· скоро</span></h3>
      <ul>
        {b.topics.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  ))}
</Layout>
