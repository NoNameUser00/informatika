---
import Layout from '../../layouts/Layout.astro';
import { LESSONS_9 } from '../../data/lessons';
const B = import.meta.env.BASE_URL;
const grade = '9';
---
<Layout title="9 класс — Информатика">
  <h1>9 класс · Таблицы, массивы, графы</h1>
  <p class="muted">Учебный год открывает урок 0. Дальше — три блока: теория, уроки целиком, тренажеры, проверочные и контрольные.</p>
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}${grade}/tb/`}>Открыть презентацию →</a></p>
  </div>
  <h2>Электронные таблицы</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/sheets/`}>Тренажер по таблицам</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-9sheet/`}>Проверочная (5 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-9sheet/`}>Контрольная (8 заданий)</a>
  </div>
  {LESSONS_9.filter((l) => l.id.startsWith('9sheet')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 1}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Массивы в Python</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/arrays/`}>Тренажер по массивам</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-9arr/`}>Проверочная (5 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-9arr/`}>Контрольная (8 заданий)</a>
  </div>
  {LESSONS_9.filter((l) => l.id.startsWith('9arr')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 4}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Графы</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/graphs/`}>Тренажер по графам</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-9graph/`}>Проверочная (5 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-9graph/`}>Контрольная (8 заданий)</a>
  </div>
  {LESSONS_9.filter((l) => l.id.startsWith('9graph')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 6}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
  <h2>Роботы, модели, интернет</h2>
  <div class="card">
    <a class="btn" href={`${B}${grade}/extra/`}>Тренажер: роботы и модели</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/proverka-9extra/`}>Проверочная (5 заданий)</a>
    <span> </span>
    <a class="btn secondary" href={`${B}${grade}/control-9extra/`}>Контрольная (8 заданий)</a>
  </div>
  {LESSONS_9.filter((l) => l.id.startsWith('9robot') || l.id.startsWith('9model') || l.id.startsWith('9net')).map((l, i) => (
    <div class="card">
      <h3>Урок {i + 7}. {l.title}</h3>
      <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
    </div>
  ))}
</Layout>
