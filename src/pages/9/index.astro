---
import Layout from '../../layouts/Layout.astro';
import StudyProgress from '../../components/StudyProgress';
import { LESSONS_9 } from '../../data/lessons';
const B = import.meta.env.BASE_URL;
const grade = '9';
// Разделы КТП 9 класса: уроки сгруппированы по блокам, нумерация — по КТП (1..36).
const SECTIONS = [
  { title: 'Уроки 1–11. Электронные таблицы', range: [1, 11] as const, checks: [
    { name: 'Тренажер по таблицам', slug: 'sheets' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-9sheet' },
    { name: 'Контрольная (10 заданий)', slug: 'control-9sheet' },
  ] },
  { title: 'Уроки 12–17. Программирование: алгоритмы и массивы', range: [12, 17] as const, checks: [
    { name: 'Тренажер по массивам', slug: 'arrays' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-9arr' },
    { name: 'Контрольная (10 заданий)', slug: 'control-9arr' },
  ] },
  { title: 'Уроки 18–19. Управление и роботизированные системы', range: [18, 19] as const, checks: null },
  { title: 'Уроки 20–23. Моделирование как метод познания', range: [20, 23] as const, checks: [
    { name: 'Тренажер: роботы и модели', slug: 'extra' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-9extra' },
    { name: 'Контрольная (10 заданий)', slug: 'control-9extra' },
  ] },
  { title: 'Уроки 24–27. Графы и списки', range: [24, 27] as const, checks: [
    { name: 'Тренажер по графам', slug: 'graphs' },
    { name: 'Проверочная (6 заданий)', slug: 'proverka-9graph' },
    { name: 'Контрольная (10 заданий)', slug: 'control-9graph' },
  ] },
  { title: 'Уроки 28–36. Итоги, Интернет и работа в информационном пространстве', range: [28, 36] as const, checks: null },
];
---
<Layout title="9 класс — Информатика">
  <h1>9 класс · Таблицы, массивы, графы</h1>
  <p class="muted">36 уроков по КТП. Учебный год открывает вводный слайд по технике безопасности.</p>
  <StudyProgress client:load grade="9" />
  <div class="card">
    <h3>Урок 0. Техника безопасности в кабинете информатики</h3>
    <p><a href={`${B}${grade}/tb/`}>Открыть презентацию →</a></p>
  </div>
  {SECTIONS.map((sec) => (
    <Fragment>
      <h2>{sec.title}</h2>
      {sec.checks && (
        <div class="card">
          {sec.checks.map((c) => (
            <Fragment>
              <a class="btn secondary" href={`${B}${grade}/${c.slug}/`}>{c.name}</a>
              <span> </span>
            </Fragment>
          ))}
        </div>
      )}
      {LESSONS_9.filter((l) => sec.range[0] <= (l.ktp ?? 0) && (l.ktp ?? 99) <= sec.range[1]).map((l) => (
        <div class="card">
          <h3>Урок {l.ktp}. {l.title}</h3>
          <p><a href={`${B}${grade}/${l.id}/`}>Читать теорию →</a></p>
        </div>
      ))}
    </Fragment>
  ))}
</Layout>
