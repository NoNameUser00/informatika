{
  "name": "informatics-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "node src/lib/scoring/check.test.mjs && node src/lib/variants/generator.test.mjs && node src/lib/variants/resolve.test.mjs && node src/lib/matching/drop.test.mjs && node src/lib/progress/store.test.mjs && node src/lib/progress/study.test.mjs && node src/lib/pyrun/compare.test.mjs && node src/lib/attempts/quiet.test.mjs && node src/lib/space/eco.test.mjs && node src/lib/analytics/aggregate.test.mjs && node scripts/edge-sync.test.mjs && node scripts/shuffle-options.test.mjs && node scripts/option-order.test.mjs && node scripts/key-review.test.mjs && node scripts/distractor-length.test.mjs && node scripts/legacy-generators.test.mjs && node scripts/audit-keys.test.mjs && node scripts/audit-keys.mjs",
    "audit:keys": "node scripts/audit-keys.mjs",
    "validate-bank": "npx esbuild scripts/validate-bank.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/validate-bank.cjs --log-level=error && node node_modules/.cache/validate-bank.cjs",
    "bank:gen": "node scripts/make-numsys-bank.mjs",
    "trainer:json": "npx esbuild scripts/build-trainer-json.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/trainer-json.cjs --log-level=error && node node_modules/.cache/trainer-json.cjs",
    "bank:30": "node scripts/check-30.mjs",
    "test:e2e": "playwright test",
    "checks": "npx esbuild scripts/make-checks.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/make-checks.cjs --log-level=error && node node_modules/.cache/make-checks.cjs",
    "edge:sync": "node scripts/edge-sync.mjs",
    "offline:hash": "node scripts/offline-hash.mjs",
    "build:offline-student": "node scripts/offline-build.mjs student",
    "build:offline-teacher": "node scripts/offline-build.mjs teacher",
    "app:student": "node scripts/offline-pack.mjs student",
    "app:teacher": "node scripts/offline-pack.mjs teacher",
    "offline:all": "node scripts/offline-all.mjs",
    "offline:bundle": "python scripts/offline-bundle.py",
    "lint": "echo \"eslint TODO: подключить после npm install\"",
    "rebuild": "node scripts/rebuild-all.mjs",
    "rebuild:check": "node scripts/rebuild-all.mjs --check"
  },
  "dependencies": {
    "@astrojs/react": "^3.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@supabase/supabase-js": "^2.117.2",
    "astro": "^4.16.0",
    "blockly": "^13.3.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@vite-pwa/astro": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
