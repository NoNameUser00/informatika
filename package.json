{
  "name": "informatics-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "node src/lib/scoring/check.test.mjs && node src/lib/variants/generator.test.mjs",
    "validate-bank": "npx esbuild scripts/validate-bank.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/validate-bank.cjs --log-level=error && node node_modules/.cache/validate-bank.cjs",
    "bank:gen": "node scripts/make-numsys-bank.mjs",
    "trainer:json": "node scripts/build-trainer-json.mjs",
    "bank:30": "node scripts/check-30.mjs",
    "lint": "echo \"eslint TODO: подключить после npm install\""
  },
  "dependencies": {
    "@astrojs/react": "^3.6.0",
    "astro": "^4.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
