{
  "name": "informatics-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "node src/lib/scoring/check.test.mjs && node src/lib/variants/generator.test.mjs && node src/lib/variants/resolve.test.mjs && node src/lib/matching/drop.test.mjs && node src/lib/progress/store.test.mjs && node src/lib/progress/study.test.mjs && node src/lib/pyrun/compare.test.mjs && node src/lib/attempts/quiet.test.mjs && node src/lib/space/eco.test.mjs && node src/lib/analytics/aggregate.test.mjs && node scripts/edge-sync.test.mjs",
    "validate-bank": "npx esbuild scripts/validate-bank.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/validate-bank.cjs --log-level=error && node node_modules/.cache/validate-bank.cjs",
    "bank:gen": "node scripts/make-numsys-bank.mjs",
    "trainer:json": "npx esbuild scripts/build-trainer-json.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/trainer-json.cjs --log-level=error && node node_modules/.cache/trainer-json.cjs",
    "bank:30": "node scripts/check-30.mjs",
    "checks": "npx esbuild scripts/make-checks.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/make-checks.cjs --log-level=error && node node_modules/.cache/make-checks.cjs",
    "edge:sync": "node scripts/edge-sync.mjs",
    "lint": "echo \"eslint TODO: подключить после npm install\""
  },
  "dependencies": {
    "@astrojs/react": "^3.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@supabase/supabase-js": "^2.117.2",
    "astro": "^4.16.0",
    "blockly": "^13.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
