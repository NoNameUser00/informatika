# Фронтенд (Astro). Реальные ключи не коммитить.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Яндекс-провайдер в Supabase (Custom OIDC, см. docs/auth-setup.md). По умолчанию custom:yandex.
PUBLIC_YANDEX_PROVIDER=custom:yandex
# Opt-in dev-модели. Только локально в .env, никогда в репозиторий.
# DEEPSEEK_API_KEY=
